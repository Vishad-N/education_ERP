# Local development only. Do not put production secrets in this file.

COMPOSE_PROJECT_NAME=education_erp
SITE_NAME=erp.localhost
ADMIN_PASSWORD=admin
DB_ROOT_PASSWORD=admin
MARIADB_HOST=mariadb
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
REDIS_SOCKETIO=redis-socketio:6379
SOCKETIO_PORT=9000

# Pinned source refs must be replaced with approved exact tags/SHAs before release.
FRAPPE_VERSION=v16.19.0
ERPNEXT_VERSION=v16.22.0
EDUCATION_REF=version-16
CRM_VERSION=v1.72.0
FRAPPE_DOCKER_REF=PIN_EXACT_SHA

# Development providers use fake/sandbox adapters unless explicitly approved.
PAYMENT_PROVIDER=fake
SMS_PROVIDER=fake
EMAIL_PROVIDER=local
OBJECT_STORAGE_PROVIDER=local
MALWARE_SCANNER_PROVIDER=fake
